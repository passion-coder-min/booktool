{
  "name": "@booktool/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "booktool": "dist/cli.js"
  },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --outfile=dist/cli.js --banner:js='#!/usr/bin/env node' && chmod +x dist/cli.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@booktool/mdtypst": "workspace:*",
    "@booktool/shared": "workspace:*",
    "highlight.js": "^11.11.0",
    "katex": "^0.16.11",
    "mermaid": "^11.4.0",
    "rehype-highlight": "^7.0.1",
    "rehype-katex": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^3.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.1",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.0"
  }
}
